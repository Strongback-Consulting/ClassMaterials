//ALLOCZU1 JOB CLASS=A,MSGCLASS=A,MSGLEVEL=(1,1),NOTIFY=&SYSUID
//* *************************************************************
//* *
//* * Allocates zunit datasets under your HLQ
//* *
//* *************************************************************
//DELIST EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DELETE &SYSUID..ZUNIT.AZUCFG
  IF LASTCC = 8 THEN SET MAXCC = 4
  DELETE &SYSUID..ZUNIT.AZUGEN
  IF LASTCC = 8 THEN SET MAXCC = 4
  DELETE &SYSUID..ZUNIT.AZURES
  IF LASTCC = 8 THEN SET MAXCC = 4
  DELETE &SYSUID..ZUNIT.AZUSCH
  IF LASTCC = 8 THEN SET MAXCC = 4
  DELETE &SYSUID..ZUNIT.AZUTDT
  IF LASTCC = 8 THEN SET MAXCC = 4
  DELETE &SYSUID..ZUNIT.COBOL
  IF LASTCC = 8 THEN SET MAXCC = 4
  DELETE &SYSUID..ZUNIT.GEN.COBOL
  IF LASTCC = 8 THEN SET MAXCC = 4
  DELETE &SYSUID..ZUNIT.COPYLIB
  IF LASTCC = 8 THEN SET MAXCC = 4
  DELETE &SYSUID..ZUNIT.CNTL
  IF LASTCC = 8 THEN SET MAXCC = 4
  DELETE &SYSUID..ZUNIT.LISTING
  IF LASTCC = 8 THEN SET MAXCC = 4
  DELETE &SYSUID..ZUNIT.LOAD
  IF LASTCC = 8 THEN SET MAXCC = 4
  DELETE &SYSUID..ZUNIT.SYSDEBUG
  IF LASTCC = 8 THEN SET MAXCC = 4
  DELETE &SYSUID..ZUNIT.PLI
  IF LASTCC = 8 THEN SET MAXCC = 4
  DELETE &SYSUID..ZUNIT.PLI.INCLUDE
  IF LASTCC = 8 THEN SET MAXCC = 4
  DELETE &SYSUID..ZUNIT.PLI.LISTING
  IF LASTCC = 8 THEN SET MAXCC = 4
/*
//*
//* *************************************************************
//* STEP: ALLOC
//*
//*  ALLOCATE DATASETS NEEDED FOR LABS
//*
//* *************************************************************
//*
//ALLOC EXEC PGM=IEFBR14,COND=(4,LT)
//AZUCFG DD DSN=&SYSUID..ZUNIT.AZUCFG,DISP=(NEW,CATLG,DELETE),
//      RECFM=VBA,LRECL=16383,BLKSIZE=32760,SPACE=(TRK,(2,1,20)),
//      DSNTYPE=LIBRARY
//AZUGEN DD DSN=&SYSUID..ZUNIT.AZUGEN,DISP=(NEW,CATLG,DELETE),
//      RECFM=VBA,LRECL=16383,BLKSIZE=32760,SPACE=(TRK,(2,1,20)),
//      DSNTYPE=LIBRARY
//AZURES DD DSN=&SYSUID..ZUNIT.AZURES,DISP=(NEW,CATLG,DELETE),
//      RECFM=VBA,LRECL=16383,BLKSIZE=32760,SPACE=(TRK,(2,1,20)),
//      DSNTYPE=LIBRARY
//AZUSCH DD DSN=&SYSUID..ZUNIT.AZUSCH,DISP=(NEW,CATLG,DELETE),
//      RECFM=VBA,LRECL=16383,BLKSIZE=32760,SPACE=(TRK,(2,1,20)),
//      DSNTYPE=LIBRARY
//AZUTDT DD DSN=&SYSUID..ZUNIT.AZUTDT,DISP=(NEW,CATLG,DELETE),
//      RECFM=VBA,LRECL=16383,BLKSIZE=32760,SPACE=(TRK,(2,1,20)),
//      DSNTYPE=LIBRARY
//COBSRC DD DSN=&SYSUID..ZUNIT.COBOL,DISP=(NEW,CATLG,DELETE),
//      RECFM=FB,LRECL=80,BLKSIZE=8000,SPACE=(TRK,(2,1,20)),
//      DSNTYPE=LIBRARY
//GENSRC DD DSN=&SYSUID..ZUNIT.GEN.COBOL,DISP=(NEW,CATLG,DELETE),
//      RECFM=FB,LRECL=80,BLKSIZE=8000,SPACE=(TRK,(2,1,20)),
//      DSNTYPE=LIBRARY
//CPYSRC DD DSN=&SYSUID..ZUNIT.COPYLIB,DISP=(NEW,CATLG,DELETE),
//      RECFM=FB,LRECL=80,BLKSIZE=8000,SPACE=(TRK,(2,1,20)),
//      DSNTYPE=LIBRARY
//JCLSRC DD DSN=&SYSUID..ZUNIT.CNTL,DISP=(NEW,CATLG,DELETE),
//      RECFM=FB,LRECL=80,BLKSIZE=8000,SPACE=(TRK,(2,1,20)),
//      DSNTYPE=LIBRARY
//COBLST DD DSN=&SYSUID..ZUNIT.LISTING,DISP=(NEW,CATLG,DELETE),
//      RECFM=FBA,LRECL=133,BLKSIZE=1330,SPACE=(TRK,(2,1,20)),
//      DSNTYPE=LIBRARY
//LOADL  DD DSN=&SYSUID..ZUNIT.LOAD,DISP=(NEW,CATLG,DELETE),
//      RECFM=U,BLKSIZE=6233,SPACE=(TRK,(2,1,20)),
//      DSNTYPE=LIBRARY
//DEBUG DD DSN=&SYSUID..ZUNIT.SYSDEBUG,DISP=(NEW,CATLG,DELETE),
//      RECFM=FB,LRECL=1024,BLKSIZE=31744,SPACE=(TRK,(2,1,20)),
//      DSNTYPE=LIBRARY
//PLISRC DD DSN=&SYSUID..ZUNIT.PLI,DISP=(NEW,CATLG,DELETE),
//      RECFM=FB,LRECL=80,BLKSIZE=8000,SPACE=(TRK,(2,1,20)),
//      DSNTYPE=LIBRARY
//PLILST DD DSN=&SYSUID..ZUNIT.PLI.LISTING,DISP=(NEW,CATLG,DELETE),
//      RECFM=VBA,LRECL=137,BLKSIZE=32760,SPACE=(TRK,(2,1,20)),
//      DSNTYPE=LIBRARY
//PLIINC DD DSN=&SYSUID..ZUNIT.PLI.INCLUDE,DISP=(NEW,CATLG,DELETE),
//      RECFM=FB,LRECL=80,BLKSIZE=32720,SPACE=(TRK,(2,1,20)),
//      DSNTYPE=LIBRARY
/*
//